<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Catálogo — KN Center</title>
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="icon" href="/icon-192.png">
<style>
  :root {
    --ink: #1d1d1f;
    --muted: #86868b;
    --bg: #fbfbfd;
    --card: #ffffff;
    --linha: #e8e8ed;
    --azul: #0071e3;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  .oculto { display: none !important; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Helvetica, Arial, sans-serif;
    background: var(--bg);
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
  }

  header {
    text-align: center;
    padding: 56px 20px 36px;
  }
  header img { height: 34px; width: auto; margin-bottom: 18px; }
  header h1 {
    font-size: clamp(28px, 5vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0 0 8px;
  }
  header p {
    color: var(--muted);
    font-size: 17px;
    margin: 0;
  }

  .barra {
    max-width: 1100px;
    margin: 0 auto 8px;
    padding: 0 24px;
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .filtro-pill {
    border: 1px solid var(--linha);
    background: #fff;
    color: var(--ink);
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 13px;
    cursor: pointer;
    transition: background .15s, color .15s;
  }
  .filtro-pill:hover { background: #f5f5f7; }
  .filtro-pill.ativo { background: var(--ink); color: #fff; border-color: var(--ink); }

  .btn-pdf {
    position: fixed;
    top: 20px;
    right: 20px;
    background: var(--azul);
    color: #fff;
    border: none;
    padding: 10px 18px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    box-shadow: 0 2px 10px rgba(0,0,0,.12);
    z-index: 10;
  }
  .btn-pdf:hover { background: #0077ed; }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 32px 24px 100px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 28px;
  }

  .card {
    background: var(--card);
    border-radius: 18px;
    overflow: hidden;
    break-inside: avoid;
    page-break-inside: avoid;
  }
  .foto {
    aspect-ratio: 1 / 1;
    width: 100%;
    background: #f5f5f7;
    border-radius: 18px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto .sem-foto {
    color: var(--muted);
    font-size: 13px;
  }
  .info { padding: 14px 4px 4px; }
  .categoria {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 4px;
  }
  .nome {
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
    line-height: 1.25;
  }
  .condicao {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 8px;
  }
  .preco {
    font-size: 19px;
    font-weight: 700;
    margin: 0;
  }
  .preco.consulte { color: var(--muted); font-weight: 500; font-size: 15px; }

  .vazio {
    text-align: center;
    color: var(--muted);
    padding: 80px 20px;
  }

  @media (max-width: 480px) {
    header { padding: 40px 16px 26px; }
    .grid { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 18px; }
  }

  @media print {
    .no-print { display: none !important; }
    body { background: #fff; }
    header { padding: 10px 0 24px; }
    main { padding: 0 10px 20px; max-width: 100%; }
    .grid { grid-template-columns: repeat(3, 1fr); gap: 16px; }
    .card { break-inside: avoid; page-break-inside: avoid; }
  }
</style>
</head>
<body>

<button class="btn-pdf no-print" onclick="window.print()">⬇︎ Baixar PDF</button>

<header>
  <img src="/logo.png" alt="KN Center">
  <h1>Catálogo</h1>
  <p>Produtos disponíveis agora</p>
</header>

<div class="barra no-print" id="filtros"></div>

<main>
  <div class="grid" id="grid"></div>
  <div class="vazio oculto" id="vazio">Nenhum produto disponível no momento.</div>
</main>

<script>
  const fmt = (n) => 'R$ ' + Number(n).toLocaleString('pt-BR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  let PRODUTOS = [];
  let CATEGORIA_ATIVA = '';

  function renderFiltros() {
    const categorias = [...new Set(PRODUTOS.map(p => p.categoria))].sort();
    const box = document.getElementById('filtros');
    if (categorias.length <= 1) { box.innerHTML = ''; return; }
    box.innerHTML = `<button class="filtro-pill ${CATEGORIA_ATIVA === '' ? 'ativo' : ''}" data-cat="">Tudo</button>` +
      categorias.map(c => `<button class="filtro-pill ${CATEGORIA_ATIVA === c ? 'ativo' : ''}" data-cat="${c}">${c}</button>`).join('');
    box.querySelectorAll('.filtro-pill').forEach(b => b.addEventListener('click', () => {
      CATEGORIA_ATIVA = b.dataset.cat;
      renderFiltros();
      renderGrid();
    }));
  }

  function renderGrid() {
    const lista = CATEGORIA_ATIVA ? PRODUTOS.filter(p => p.categoria === CATEGORIA_ATIVA) : PRODUTOS;
    const grid = document.getElementById('grid');
    document.getElementById('vazio').classList.toggle('oculto', lista.length > 0);
    grid.innerHTML = lista.map(p => `
      <div class="card">
        <div class="foto">
          ${p.fotos && p.fotos.length ? `<img src="${p.fotos[0]}" loading="lazy" alt="${p.nome}">` : `<span class="sem-foto">Sem foto</span>`}
        </div>
        <div class="info">
          <p class="categoria">${p.categoria || ''}</p>
          <p class="nome">${p.nome}</p>
          ${p.condicao ? `<p class="condicao">${p.condicao}</p>` : ''}
          ${p.preco_anuncio != null ? `<p class="preco">${fmt(p.preco_anuncio)}</p>` : `<p class="preco consulte">Consulte o valor</p>`}
        </div>
      </div>
    `).join('');
  }

  fetch('/publico/catalogo')
    .then(r => r.json())
    .then(r => {
      PRODUTOS = r.data || [];
      renderFiltros();
      renderGrid();
    })
    .catch(() => {
      document.getElementById('vazio').textContent = 'Não deu pra carregar o catálogo agora. Tenta de novo em instantes.';
      document.getElementById('vazio').classList.remove('oculto');
    });
</script>

</body>
</html>
